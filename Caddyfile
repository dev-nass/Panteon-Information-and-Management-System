{
    admin off
    persist_config off
    auto_https off

    frankenphp
}

:{$PORT:8080} {
    root * /app/public

    encode zstd br gzip

    # Vite hashed assets: immutable for a year
    @hashed_assets path_regexp ^/build/assets/[^/]+-[A-Za-z0-9_-]{8}\.(js|css)$
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # Images and fonts: 30 days
    @static_files path_regexp \.(webp|png|jpe?g|gif|svg|ico|woff2?|ttf)$
    header @static_files Cache-Control "public, max-age=2592000"

    file_server {
        hide .git
        hide .env*
    }

    php_server
}